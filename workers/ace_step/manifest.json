{
  "id": "ace_step",
  "displayName": "ACE-Step 1.5 (music)",
  "description": "Music from a style prompt: intro and outro themes, scene beds, songs. Instrumental unless lyrics are set. 10 s to 10 min, stereo 48 kHz. MIT license.",
  "experimental": true,
  "tags": ["Music"],
  "priority": 70,
  "modelVersion": "1.5-xl",
  "maxChars": 1000,
  "sampleRate": 48000,
  "voiceCloning": false,
  "approxVramGb": 16,
  "devices": ["cuda"],
  "length": { "mode": "required", "min": 10, "max": 600 },
  "settings": [
    { "key": "model", "type": "enum", "label": "Model", "default": "turbo",
      "options": ["turbo", "sft"],
      "optionLabels": ["XL Turbo (fast, 8 steps)", "XL SFT (more detail, ~50 steps)"] },
    { "key": "lyrics", "type": "string", "multiline": true, "label": "Lyrics", "default": "",
      "description": "Empty = instrumental. For a song, structured lyrics such as \"[verse] ... [chorus] ...\". Set it per segment with Override settings." },
    { "key": "language", "type": "enum", "label": "Lyrics language", "default": "en",
      "options": ["en", "zh", "ja", "ko", "es", "fr", "de", "it", "pt", "ru"],
      "optionLabels": ["English", "Chinese", "Japanese", "Korean", "Spanish", "French", "German", "Italian", "Portuguese", "Russian"] },
    { "key": "bpm", "type": "int", "min": 0, "max": 300, "default": 0, "label": "BPM",
      "description": "0 = let the model choose." },
    { "key": "key", "type": "string", "label": "Key", "default": "",
      "description": "For example \"A minor\" or \"C major\". Empty = let the model choose." },
    { "key": "steps", "type": "int", "min": 0, "max": 100, "default": 0, "label": "Steps",
      "description": "0 = the model's default (Turbo 8, SFT 50)." },
    { "key": "guidance", "type": "float", "min": 1.0, "max": 15.0, "step": 0.5, "default": 7.0, "label": "Guidance (SFT)",
      "description": "How closely SFT follows the prompt. Turbo ignores it (guidance is built in)." },
    { "key": "seed", "type": "seed", "label": "Seed" }
  ]
}
