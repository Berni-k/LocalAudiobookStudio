{
  "id": "vibevoice",
  "displayName": "VibeVoice",
  "description": "Expressive long-form TTS with voice cloning from a reference clip. Without a clip it uses one of the bundled preset voices.",
  "tags": ["Voice", "Voice clone"],
  "priority": 90,
  "modelVersion": "1.5B",
  "maxChars": 1500,
  "sampleRate": 24000,
  "voiceCloning": true,
  "approxVramGb": 8,
  "devices": ["cuda", "cpu"],
  "cpuRecommended": false,
  "cpuNote": "Very slow on the CPU (float32, SDPA; upstream's CPU path). Use the 1.5B model: 7B needs about 30 GB of RAM.",
  "fusion": { "speakers": 4, "maxChars": 5000, "context": ["text"] },
  "settings": [
    { "key": "voice", "type": "enum", "label": "Preset voice", "default": "en-Carter_man", "perVoice": true,
      "description": "Used when the speaker has no voice-cloning reference clip.",
      "options": ["en-Carter_man", "en-Alice_woman", "en-Frank_man", "en-Maya_woman", "in-Samuel_man", "zh-Xinran_woman", "zh-Bowen_man"],
      "optionLabels": ["Carter (EN, male)", "Alice (EN, female)", "Frank (EN, male)", "Maya (EN, female)", "Samuel (EN/IN, male)", "Xinran (ZH, female)", "Bowen (ZH, male)"] },
    { "key": "model", "type": "enum", "label": "Model", "default": "vibevoice/VibeVoice-1.5B",
      "description": "7B sounds better but needs about 19 GB of VRAM and is slower. Switching models reloads the worker's model.",
      "options": ["vibevoice/VibeVoice-1.5B", "vibevoice/VibeVoice-7B"],
      "optionLabels": ["1.5B (fast, ~8 GB)", "7B (best, ~19 GB)"] },
    { "key": "cfgScale", "type": "float", "min": 1.0, "max": 3.0, "step": 0.05, "default": 1.3, "label": "CFG scale" },
    { "key": "steps", "type": "int", "min": 5, "max": 50, "default": 10, "label": "Diffusion steps" },
    { "key": "seed", "type": "seed", "label": "Seed" }
  ]
}
