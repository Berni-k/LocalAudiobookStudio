<Project>
  <!-- Every NuGet package version in one place (central package management); .csproj files list packages without versions. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <NAudioVersion>3.1.0</NAudioVersion>
    <MicrosoftExtensionsVersion>10.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <ItemGroup Label="Desktop app">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia" Version="11.3.22" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Audio">
    <PackageVersion Include="NAudio.Core" Version="$(NAudioVersion)" />
    <PackageVersion Include="NAudio.Wasapi" Version="$(NAudioVersion)" />
    <PackageVersion Include="NAudio.Alsa" Version="$(NAudioVersion)" />
    <!-- Compressed audio, pure C#: the Opus codec (the Ogg container is ours, Audio/Decoding/OggOpus.cs) and MP3 decoding. -->
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <PackageVersion Include="NLayer" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup Label="HartsyInference worker">
    <!-- Alpha library: pin an exact version (its README asks for this). -->
    <PackageVersion Include="HartsyInference.Engine" Version="2.0.0-alpha.378" />
  </ItemGroup>

  <ItemGroup Label="Internal worker (whisper.cpp, ONNX Runtime)">
    <!--
      The worker bundles the CPU builds; the GPU runtime downloads the Vulkan and CUDA builds of the same version
      (InternalGpuRuntime.WhisperNetVersion, which a test keeps in step with this one).
    -->
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
    <!-- Parakeet on the CPU in the internal worker (the same ONNX export the Python ONNX runtimes use). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
