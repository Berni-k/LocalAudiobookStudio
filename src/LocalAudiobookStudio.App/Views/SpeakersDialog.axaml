<!-- Speakers: list on the left, editor on the right. Changes apply immediately. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalAudiobookStudio.App.ViewModels"
        xmlns:ctl="using:LocalAudiobookStudio.App.Controls"
        x:Class="LocalAudiobookStudio.App.Views.SpeakersDialog"
        x:DataType="vm:SpeakersDialogViewModel"
        Title="Speakers"
        Width="920" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="Changing a speaker's worker, voice or settings marks its segments stale." Classes="caption" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Close" Click="OnClose" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center" />
    </Grid>

    <Grid ColumnDefinitions="240,16,*">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Content="Add…" Command="{Binding AddCommand}" />
          <Button Content="Delete…" Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}" />
        </StackPanel>
        <Border Classes="card" Padding="2">
          <ListBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding Selected}" Classes="side">
            <!-- Right-clicking a speaker selects it; the menu acts on the selected speaker. -->
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy settings" Command="{Binding CopySettingsCommand}" />
                <MenuItem Header="{Binding PasteHeader}" IsEnabled="{Binding CanPasteSettings}">
                  <MenuItem Header="Everything" Command="{Binding PasteAllCommand}"
                            ToolTip.Tip="Model, voice and settings, transcription and context: all but the name, colour and aliases" />
                  <MenuItem Header="Model, voice and settings" Command="{Binding PasteGenerationCommand}" />
                  <MenuItem Header="Transcription" Command="{Binding PasteTranscriptionCommand}" />
                  <MenuItem Header="Context" Command="{Binding PasteContextCommand}" />
                </MenuItem>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SpeakerViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Width="12" Height="12" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding WorkerName}" Classes="caption" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding ShortcutText}" Classes="caption" VerticalAlignment="Center" ToolTip.Tip="Shortcut key" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>

      <!-- Editor in three groups: the speaker itself, its transcription, its generation (with everything model-specific), and a preview.
           Each group is a form: labels on the left share one width per group (SharedSizeGroup "label"). -->
      <ScrollViewer Grid.Column="2" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="12" Margin="0,0,12,0">
          <!-- ===== Speaker -->
          <Border Classes="group">
            <StackPanel Classes="form" Grid.IsSharedSizeScope="True">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Speaker" Classes="groupTitle" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Default speaker" Classes="caption warning" IsVisible="{Binding IsDefault}" VerticalAlignment="Center" />
                  <Button Content="Make default" Command="{Binding MakeDefaultCommand}" IsVisible="{Binding !IsDefault}" FontSize="12" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="caption" Margin="0,-4,0,4">
                <Run Text="{Binding SpeakerId, StringFormat='Id: {0}'}" />
                <Run Text=" · " />
                <Run Text="{Binding SegmentCount, StringFormat='{}{0} segment(s) use this speaker'}" />
              </TextBlock>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Name" Classes="formLabel" />
                <TextBox Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Color" Classes="formLabel" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <!-- Current color; opens the custom picker. The dots after it are quick picks. -->
                  <Button Padding="4" MinHeight="0" ToolTip.Tip="Pick a custom color" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                              Background="{Binding Color, Converter={x:Static ctl:Converters.ColorToBrush}}" />
                      <TextBlock Text="{Binding Color}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, monospace" Margin="0,0,4,0" />
                    </StackPanel>
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <ctl:ColorPickerPanel Color="{Binding Color}" />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="{Binding Converter={x:Static ctl:Converters.ColorToBrush}}"
                                Command="{Binding $parent[Window].((vm:SpeakersDialogViewModel)DataContext).PickColorCommand}" CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Marker aliases" Classes="formLabel" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBox Text="{Binding Aliases, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Text="Labels in imported text that mean this speaker, comma separated." Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ===== Transcription: with None selected it is only the dropdown. -->
          <Border Classes="group">
            <StackPanel Classes="form" Grid.IsSharedSizeScope="True">
              <TextBlock Text="Transcription" Classes="groupTitle" Margin="0,0,0,4" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Worker" Classes="formLabel" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <ComboBox ItemsSource="{Binding Transcribers}" SelectedItem="{Binding Transcriber}" HorizontalAlignment="Stretch"
                            Classes.missing="{Binding IsTranscriberMissing}" PlaceholderText="Choose a worker" />
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsTranscriberMissing}">
                    <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12" Foreground="{DynamicResource SemiColorDanger}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MissingTranscriberText}" Classes="caption error" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420" />
                  </StackPanel>
                  <TextBlock Text="{Binding TranscriberInfo}" Classes="caption" TextWrapping="Wrap"
                             IsVisible="{Binding HasTranscriber}" />
                </StackPanel>
              </Grid>
              <ContentControl Content="{Binding TranscriberSettings}" />
            </StackPanel>
          </Border>

          <!-- ===== Generation -->
          <Border Classes="group">
            <StackPanel Classes="form" Grid.IsSharedSizeScope="True">
              <TextBlock Text="Generation" Classes="groupTitle" Margin="0,0,0,4" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Worker" Classes="formLabel" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <ComboBox ItemsSource="{Binding Workers}" SelectedItem="{Binding Worker}" HorizontalAlignment="Stretch"
                            Classes.missing="{Binding IsWorkerMissing}" PlaceholderText="Choose a worker" />
                  <!-- The project uses a worker this machine doesn't have. -->
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsWorkerMissing}">
                    <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12" Foreground="{DynamicResource SemiColorDanger}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MissingWorkerText}" Classes="caption error" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420" />
                    <Button Classes="link" Content="clear" Command="{Binding ClearMissingWorkerCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Clear it so you can pick one of your installed workers" />
                  </StackPanel>
                  <TextBlock Text="{Binding WorkerInfo}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsWorkerMissing}" />
                </StackPanel>
              </Grid>
              <Grid IsVisible="{Binding SupportsCloning}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Reference clip" Classes="formLabel" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Text="{Binding VoiceFile}" IsReadOnly="True" Watermark="no reference clip" />
                    <!-- The menu (file, project assets, none) is built in code-behind when clicked. -->
                    <Button Grid.Column="1" Content="Choose ▾" Click="OnChooseVoice" Margin="4,0,0,0" />
                    <Button Grid.Column="2" Classes="icon" Command="{Binding PlayVoiceFileCommand}" ToolTip.Tip="Play reference clip" Margin="4,0,0,0">
                      <PathIcon Data="{StaticResource IconPlay}" />
                    </Button>
                  </Grid>
                  <TextBlock Text="Voice cloning: 5–30 s of clean speech, from a file or the project's assets." Classes="caption" />
                </StackPanel>
              </Grid>
              <!-- Model settings: rows from the settings form, aligned to the same label column. -->
              <ContentControl Content="{Binding Settings}" />
            </StackPanel>
          </Border>

          <!-- ===== Context: lines around a segment, and neighbouring segments, generated with it in one go. Two boxes,
               each switched on by the checkbox in its header; the settings show once it is on. The worker's limits are
               warnings at the bottom. Not part of what makes a take stale. A recorded speaker has it too (its lines can be
               context for others), without the numbers: its own segments aren't generated. -->
          <Border Classes="group" IsVisible="{Binding ShowContext}">
            <StackPanel Classes="form" Grid.IsSharedSizeScope="True">
              <TextBlock Text="Context" Classes="groupTitle" Margin="0,0,0,4" />

              <Border Classes="card" Padding="10,6,10,10">
                <StackPanel Classes="form">
                  <CheckBox IsChecked="{Binding ContextInclude}" Content="Include context" FontWeight="SemiBold"
                            ToolTip.Tip="{Binding IncludeTip}" />
                  <StackPanel Classes="form" IsVisible="{Binding ShowContextSettings}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBlock Text="Segments before" Classes="formLabel" />
                      <NumericUpDown Grid.Column="1" Value="{Binding ContextBefore}" Minimum="0" Maximum="20" Increment="1" FormatString="0"
                                     Width="130" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBlock Text="Segments after" Classes="formLabel" />
                      <NumericUpDown Grid.Column="1" Value="{Binding ContextAfter}" Minimum="0" Maximum="20" Increment="1" FormatString="0"
                                     Width="130" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBlock Text="Max characters" Classes="formLabel" />
                      <NumericUpDown Grid.Column="1" Value="{Binding ContextMaxChars}" Minimum="0" Maximum="5000" Increment="100" FormatString="0"
                                     Width="130" HorizontalAlignment="Left" ToolTip.Tip="Of context on each side" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Disabled for workers that render one voice at a time, and for recorded speakers. -->
              <Border Classes="card" Padding="10,6,10,10">
                <StackPanel Classes="form">
                  <CheckBox IsChecked="{Binding ContextBatch}" Content="Batching" FontWeight="SemiBold" IsEnabled="{Binding CanBatch}"
                            ToolTip.Tip="{Binding BatchTip}" ToolTip.ShowOnDisabled="True" />
                  <StackPanel Classes="form" IsVisible="{Binding ShowBatchSettings}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBlock Text="Max segments" Classes="formLabel" />
                      <NumericUpDown Grid.Column="1" Value="{Binding BatchMaxSegments}" Minimum="2" Maximum="100" Increment="1" FormatString="0"
                                     Watermark="Any" Width="130" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <TextBlock Text="Max characters" Classes="formLabel" />
                      <NumericUpDown Grid.Column="1" Value="{Binding BatchMaxChars}" Minimum="100" Maximum="20000" Increment="100" FormatString="0"
                                     Watermark="Any" Width="130" HorizontalAlignment="Left" ToolTip.Tip="Of the batch's segments together" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasContextSplitWarning}">
                <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12" Foreground="{DynamicResource SemiColorWarning}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Text="{Binding ContextSplitWarning}" Classes="caption warning" TextWrapping="Wrap" MaxWidth="460" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasContextSplitError}">
                <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12" Foreground="{DynamicResource SemiColorDanger}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Text="{Binding ContextSplitError}" Classes="caption error" TextWrapping="Wrap" MaxWidth="460" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ===== Preview (not for recorded speakers: they have no model) -->
          <Border Classes="group" IsVisible="{Binding CanPreview}">
            <StackPanel Classes="form" Grid.IsSharedSizeScope="True">
              <TextBlock Text="Preview" Classes="groupTitle" Margin="0,0,0,4" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Text" Classes="formLabel" />
                <TextBox Grid.Column="1" Text="{Binding PreviewText}" TextWrapping="Wrap" AcceptsReturn="False" />
              </Grid>
              <!-- What the speaker's transcription worker heard in the preview: the text with the word being played
                   highlighted, and red marks where it didn't verify (hover for why). -->
              <Grid IsVisible="{Binding ShowTranscript}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Transcript" Classes="formLabel" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <!-- Outline only, so it doesn't look like an input field. -->
                  <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="4" Padding="10,8"
                          IsVisible="{Binding HasTranscript}">
                    <ctl:TranscriptView SourceText="{Binding TranscriptSource}" Check="{Binding TranscriptCheck}" PositionMs="{Binding PlaybackMs}"
                                        TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Text="{Binding TranscriptStatus}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasTranscriptStatus}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasMismatch}">
                    <Run Text="Heard: " />
                    <Run Text="{Binding HeardText}" />
                  </TextBlock>
                </StackPanel>
              </Grid>
              <!-- Only for workers that take a length. Empty: the guess shown greyed (needed) or "auto" (optional). -->
              <Grid IsVisible="{Binding ShowPreviewLength}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Length (s)" Classes="formLabel" />
                <NumericUpDown Grid.Column="1" Value="{Binding PreviewLength}" Minimum="{Binding PreviewLengthMinimum}" Maximum="{Binding PreviewLengthMaximum}"
                               Increment="0.1" FormatString="0.0" Watermark="{Binding PreviewLengthWatermark}" Width="130" HorizontalAlignment="Left" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Generate preview" Command="{Binding PreviewCommand}" IsEnabled="{Binding !IsPreviewing}" />
                  <Button Command="{Binding PlayPreviewCommand}" IsVisible="{Binding ShowPlayPreview}" ToolTip.Tip="Play the preview again">
                    <PathIcon Data="{StaticResource IconPlay}" Width="10" Height="10" />
                  </Button>
                  <Button Command="{Binding StopPreviewCommand}" IsVisible="{Binding IsPlayingPreview}" ToolTip.Tip="Stop playing the preview">
                    <PathIcon Data="{StaticResource IconStop}" Width="10" Height="10" />
                  </Button>
                  <!-- Keeps the last preview in assets/Generated, e.g. as another speaker's reference clip. -->
                  <Button Content="Save as asset" Command="{Binding SavePreviewAsAssetCommand}" IsVisible="{Binding CanSavePreview}"
                          ToolTip.Tip="Add the last preview to the project's assets (Generated), named after the speaker and model" />
                  <TextBlock Text="{Binding PreviewStatus}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>

  <Window.Styles>
    <!-- A worker that isn't installed: red in the dropdown. -->
    <Style Selector="ComboBox.missing">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorDanger}" />
    </Style>
    <!-- Tiny text-only button. -->
    <Style Selector="Button.link">
      <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorLink}" />
    </Style>
  </Window.Styles>
</Window>
