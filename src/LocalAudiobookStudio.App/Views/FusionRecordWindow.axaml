<!-- A kept fused generation (non-modal): the worker's whole output across the top with where its takes were cut, the
     transcript under it (highlighted as it plays, mistakes marked), and the parts as the worker was sent them. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalAudiobookStudio.App.ViewModels"
        xmlns:ctl="using:LocalAudiobookStudio.App.Controls"
        x:Class="LocalAudiobookStudio.App.Views.FusionRecordWindow"
        x:DataType="vm:FusionRecordViewModel"
        Title="{Binding Title}"
        Width="1100" Height="780" MinWidth="700" MinHeight="450">
  <DockPanel Margin="16">
    <!-- What ran it, and how it was cut. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SettingsText}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasSettings}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
        <Button Classes="icon" Command="{Binding PlayFromStartCommand}" ToolTip.Tip="Play from the start" IsVisible="{Binding !IsPlaying}">
          <PathIcon Data="{StaticResource IconPlay}" />
        </Button>
        <Button Classes="icon" Command="{Binding StopCommand}" ToolTip.Tip="Stop" IsVisible="{Binding IsPlaying}">
          <PathIcon Data="{StaticResource IconStop}" />
        </Button>
        <Button Classes="icon" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open its folder">
          <PathIcon Data="{StaticResource IconFolder}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- The whole output: click plays from there, drag scrubs. Segments' cuts are marked at the top, context at the bottom. -->
    <Border DockPanel.Dock="Top" Height="150" Background="{DynamicResource WaveformBackgroundBrush}" CornerRadius="4" ClipToBounds="True">
      <Panel>
        <ctl:WaveformView Peaks="{Binding Peaks}" Host="{Binding}" PlayheadMs="{Binding PlayheadMs}" Fill="{DynamicResource WaveformBrush}" />
        <ctl:FusionMarkersView Markers="{Binding Markers}" DurationMs="{Binding DurationMs}" />
      </Panel>
    </Border>

    <!-- What the transcription heard, against all the parts' text: highlighted as it plays, differences marked. -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,8,0,0" Padding="10,8">
      <StackPanel Spacing="4">
        <TextBlock Text="Transcript" FontWeight="SemiBold" />
        <ctl:TranscriptView SourceText="{Binding TranscriptSource}" Check="{Binding TranscriptCheck}" PositionMs="{Binding PlayheadMs}"
                            TextWrapping="Wrap" IsVisible="{Binding HasTranscript}" />
        <TextBlock Text="{Binding NoTranscriptText}" Classes="caption" IsVisible="{Binding !HasTranscript}" />
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Classes="error" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding HasError}" />
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,8,0,0" Padding="10,8" IsVisible="{Binding HasRequestText}">
      <StackPanel Spacing="2">
        <TextBlock Text="Sent as one text" FontWeight="SemiBold" />
        <SelectableTextBlock Text="{Binding RequestText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- The parts, in the order the worker got them. -->
    <TextBlock DockPanel.Dock="Top" Text="Parts" FontWeight="SemiBold" Margin="0,10,0,4" />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Parts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FusionPartRow">
            <Border Classes="card" Margin="0,0,0,6" Classes.selectedTake="{Binding IsCurrent}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding SpeakerName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RoleText}" Classes="caption" VerticalAlignment="Center" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Details}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDetails}" />
                  <TextBlock Text="{Binding Timing}" Classes="caption" IsVisible="{Binding HasTiming}" />
                  <TextBlock Text="{Binding Note}" Classes="caption error" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="icon" Command="{Binding PlayCommand}" IsVisible="{Binding CanPlay}" VerticalAlignment="Top"
                        ToolTip.Tip="Play from this part">
                  <PathIcon Data="{StaticResource IconPlay}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
