<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests: no installed workers, GPUs or network, so they run anywhere and should always pass. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The internal worker is an exe; its dependency-free math is compiled in here to be tested. -->
    <Compile Include="..\..\src\LocalAudiobookStudio.InternalWorker\Fbank.cs" Link="InternalWorker\Fbank.cs" />
    <Compile Include="..\..\src\LocalAudiobookStudio.InternalWorker\VoiceMath.cs" Link="InternalWorker\VoiceMath.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalAudiobookStudio.Engine\LocalAudiobookStudio.Engine.csproj" />
  </ItemGroup>
</Project>
